{
  "name": "@multiplayer-ai/desktop",
  "productName": "Multiplayer AI",
  "version": "0.1.0",
  "private": true,
  "description": "Local desktop collaboration and agent orchestration",
  "author": "Multiplayer AI",
  "type": "module",
  "main": "out/main/index.cjs",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src scripts electron.vite.config.ts",
    "test": "pnpm run test:unit && pnpm run test:database",
    "test:unit": "tsx --test src/supervisor/*.test.ts src/shared/*.test.ts src/main/*.test.ts",
    "test:database": "node --test scripts/shared-database.test.mjs",
    "test:shared": "node scripts/shared-e2e.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:codex": "node scripts/codex-e2e.mjs",
    "test:packaged": "node scripts/e2e.mjs --packaged",
    "package": "pnpm run build && electron-builder --dir --publish never",
    "dist": "pnpm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@multiplayer-ai/db": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "lucide-react": "^1.31.0",
    "playwright": "^1.58.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.0",
    "@multiplayer-ai/ui": "workspace:*"
  },
  "build": {
    "appId": "ai.multiplayer.desktop",
    "productName": "Multiplayer AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  }
}
