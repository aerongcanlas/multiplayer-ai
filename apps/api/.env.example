# All values stay on the API host. Use the same Supabase project as the desktop.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only Postgres credentials with table privileges and RLS bypass.
# Use your provider's verified TLS connection settings for remote databases.
DATABASE_URL=postgresql://postgres:replace_me@127.0.0.1:54322/postgres
HOST=127.0.0.1
PORT=3001
